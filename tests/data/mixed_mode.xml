<?xml version="1.0" encoding="utf-8"?>
<SFDLFile xmlns:xsd="http://www.w3.org/2001/XMLSchema"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Description>Mixed mode description</Description>
    <Uploader>Mixed uploader</Uploader>
    <SFDLFileVersion>6</SFDLFileVersion>
    <Encrypted>false</Encrypted>
    <ConnectionInfo>
        <Host>ftp.example.com</Host>
        <Port>21</Port>
        <Username>mixeduser</Username>
        <Password>mixedpass</Password>
        <AuthRequired>true</AuthRequired>
        <DataConnectionType>AutoPassive</DataConnectionType>
        <DataType>Binary</DataType>
        <CharacterEncoding>UTF8</CharacterEncoding>
        <EncryptionMode>None</EncryptionMode>
        <ListMethod>ForceList</ListMethod>
        <DefaultPath>/default/mixed</DefaultPath>
        <ForceSingleConnection>false</ForceSingleConnection>
        <DataStaleDetection>true</DataStaleDetection>
        <SpecialServerMode>false</SpecialServerMode>
    </ConnectionInfo>
    <Packages>
        <SFDLPackage>
            <Packagename>MixedPackage</Packagename>
            <BulkFolderMode>false</BulkFolderMode>
            <BulkFolderList>
                <BulkFolder>
                    <BulkFolderPath>/mixed/bulk</BulkFolderPath>
                    <PackageName>MixedPackage</PackageName>
                </BulkFolder>
            </BulkFolderList>
            <FileList>
                <FileInfo>
                    <FileName>mixed.txt</FileName>
                    <DirectoryRoot>/root</DirectoryRoot>
                    <DirectoryPath>/root/mixed</DirectoryPath>
                    <FileFullPath>/root/mixed/mixed.txt</FileFullPath>
                    <FileSize>7</FileSize>
                    <FileHashType>MD5</FileHashType>
                    <FileHash>mixedhash</FileHash>
                    <PackageName>MixedPackage</PackageName>
                </FileInfo>
            </FileList>
        </SFDLPackage>
        <SFDLPackage>
            <Packagename>BulkOnlyPackage</Packagename>
            <BulkFolderMode>true</BulkFolderMode>
            <BulkFolderList>
                <BulkFolder>
                    <BulkFolderPath>/bulk/only</BulkFolderPath>
                    <PackageName>BulkOnlyPackage</PackageName>
                </BulkFolder>
            </BulkFolderList>
        </SFDLPackage>
    </Packages>
    <MaxDownloadThreads>3</MaxDownloadThreads>
</SFDLFile>
